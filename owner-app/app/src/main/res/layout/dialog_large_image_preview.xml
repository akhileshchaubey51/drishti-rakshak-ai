<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:padding="16dp">

    <!-- Header bar with title and close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDialogBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 UNKNOWN INTRUDER"
            android:textColor="@color/alert_red"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_danger_alert"
            android:fontFamily="serif" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDialogConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="96% Conf"
            android:textColor="@color/accent_green_light"
            android:textSize="12sp"
            android:fontFamily="serif" />
    </LinearLayout>

    <!-- Zoom Hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🔍 Pinch to Zoom In/Out • Double-Tap • Drag to Pan"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:gravity="center"
        android:fontFamily="serif" />

    <!-- Large High-Resolution Zoomable Image Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#000000">

        <com.homesentinel.owner.ui.ZoomableImageView
            android:id="@+id/ivLargeSnapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_camera"
            android:contentDescription="Full Alert Zoomable Snapshot" />
    </androidx.cardview.widget.CardView>

    <!-- Details Card -->
    <TextView
        android:id="@+id/tvDialogLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Person detected - Front Gate (Reported)"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/tvDialogTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="19 Oct 2026 • 10:15:02 AM"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:fontFamily="serif" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Close Full View"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:background="@drawable/btn_purple_rounded"
        android:fontFamily="serif" />

</LinearLayout>
