<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivAlertSnapshot"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_danger_alert"
            android:src="@drawable/ic_camera"
            android:contentDescription="Snapshot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAlertBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNKNOWN PERSON"
                    android:textColor="@color/alert_red"
                    android:background="@drawable/bg_danger_alert"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="94% Conf"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:fontFamily="serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAlertLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Unrecognized person in radar view"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/tvAlertTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Today, 07:15:23 PM"
                android:textColor="@color/text_light_gray"
                android:textSize="11sp"
                android:fontFamily="serif" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSirenIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_siren"
            android:contentDescription="Siren" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
